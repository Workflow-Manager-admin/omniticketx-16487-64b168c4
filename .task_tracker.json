ue\n    },\n    {\n      "name": "Admin & Vendor Portal",\n      "description": "Domain-specific event creation, dynamic pricing, analytics dashboard, and vendor-specific access.",\n      "isEnabled": true\n    },\n    {\n      "name": "Integration & Ecosystem",\n      "description": "Sync with travel APIs, social media integration, loyalty program, and plug-and-play partner onboarding.",\n      "isEnabled": true\n    },\n    {\n      "name": "Notifications & Engagement",\n      "description": "Smart reminders, push/email/SMS notifications, post-event engagement, and referral incentives.",\n      "isEnabled": true\n    },\n    {\n      "name": "Offline & Group Features",\n      "description": "Offline mode for local events, group booking/coordination, eco-friendly digital passes, and multi-currency/global support.",\n      "isEnabled": true\n    },\n    {\n      "name": "Cross-Domain Smart Bundling",\n      "description": "AI-personalized bundles (e.g., concert + hotel + ride), based on past bookings, travel patterns, budget, and occasion.",\n      "isEnabled": true\n    },\n    {\n      "name": "Geo-Aware Dynamic Content",\n      "description": "Location-based event/promotion display, alternate suggestions, and real-time \'Now Happening\' events via GPS.",\n      "isEnabled": true\n    },\n    {\n      "name": "NFT-Based Smart Tickets",\n      "description": "Blockchain-verified NFT tickets for premium events, authentic resale, digital collectibles, and fraud prevention.",\n      "isEnabled": true\n    },\n    {\n      "name": "AI-Powered Group Coordination",\n      "description": "Intelligent group booking assistant for seat finding, cost splitting, consensus suggestions, and chat app sync.",\n      "isEnabled": true\n    },\n    {\n      "name": "Voice & Chatbot Booking Assistant",\n      "description": "Book via voice (Alexa/Siri/Google), WhatsApp chatbot, in-app GPT agent, supporting multilingual/natural language input.",\n      "isEnabled": true\n    },\n    {